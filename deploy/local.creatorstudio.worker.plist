<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.creatorstudio.worker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/apple/CreatorStudio/runtime/integrations/mac-worker/worker.py</string>
        <string>--verbose</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/apple/CreatorStudio/runtime/integrations/mac-worker</string>

    <!-- Logs land in the same place the manual runs wrote to, so `make logs`
         and `tail -f` keep working after the switch to launchd. -->
    <key>StandardOutPath</key>
    <string>/Users/apple/CreatorStudio/logs/worker-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/apple/CreatorStudio/logs/worker-stderr.log</string>

    <!-- Start with the login session; restart on crash. A render takes minutes,
         so throttle restarts instead of hammering the API while the stack boots. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- The worker reads config from ~/CreatorStudio/config; point HOME at the
         real one so Path.home() resolves the same way as an interactive shell. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/apple</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
