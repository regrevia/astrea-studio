<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.creatorstudio.worker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__HOME__/CreatorStudio/runtime/integrations/mac-worker/worker.py</string>
        <string>--verbose</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__HOME__/CreatorStudio/runtime/integrations/mac-worker</string>

    <!-- Logs land in the same place the manual runs wrote to, so `make logs`
         and `tail -f` keep working after the switch to launchd. -->
    <key>StandardOutPath</key>
    <string>__HOME__/CreatorStudio/logs/worker-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/CreatorStudio/logs/worker-stderr.log</string>

    <!-- Start with the login session; restart on crash. A render takes minutes,
         so throttle restarts instead of hammering the API while the stack boots. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- The worker reads config from ~/CreatorStudio/config; point HOME at the
         real one so Path.home() resolves the same way as an interactive shell. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- 不要设成 Background：launchd 会按后台 QoS 限 CPU/IO，
         x264 编码从 20 秒级掉到 3 分钟级（实测同一份 spec 9 倍差距）。 -->
    <key>ProcessType</key>
    <string>Standard</string>
</dict>
</plist>
